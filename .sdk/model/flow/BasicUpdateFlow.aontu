# BasicUpdateFlow

main: kit: flow: BasicUpdateFlow:
{
  entity: "update",
  kind: "basic",
  name: "BasicUpdateFlow",
  step: [
    {
      i: {
        ref: "update_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "update_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicUpdateFlow"
}