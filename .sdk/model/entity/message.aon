# Entity: message

main: kit: entity: message: {

  alias: field: {}

  fields: [
    {
      name: "chat_id"
      req: true
      short: "Unique identifier for the target chat or username"
      type: "`$STRING`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "direct_messages_topic_id"
      req: false
      short: "Unique identifier for the target direct messages topic"
      type: "`$INTEGER`"
    }
    {
      name: "disable_notification"
      req: false
      short: "Sends the message silently"
      type: "`$BOOLEAN`"
    }
    {
      name: "disable_web_page_preview"
      req: false
      short: "Disables link previews for links in this message"
      type: "`$BOOLEAN`"
    }
    {
      name: "from_chat_id"
      req: true
      type: "`$STRING`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "latitude"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "longitude"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "message_effect_id"
      req: false
      short: "Unique identifier of the message effect to be added to the message"
      type: "`$STRING`"
    }
    {
      name: "message_id"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "message_thread_id"
      req: false
      short: "Unique identifier for the target message thread (topic) of the forum"
      type: "`$INTEGER`"
    }
    {
      name: "options"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "parse_mode"
      req: false
      short: "Mode for parsing entities in the message text"
      type: "`$STRING`"
    }
    {
      name: "protect_content"
      req: false
      short: "Protects the contents of the sent message from forwarding and saving"
      type: "`$BOOLEAN`"
    }
    {
      name: "question"
      req: true
      type: "`$STRING`"
    }
    {
      name: "reply_to_message_id"
      req: false
      short: "If the message is a reply, ID of the original message"
      type: "`$INTEGER`"
    }
    {
      name: "text"
      req: true
      short: "Text of the message to be sent"
      type: "`$STRING`"
    }
  ]

  name: "message"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/forwardMessage"
          parts: [
            "forwardMessage"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendAnimation"
          parts: [
            "sendAnimation"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendAudio"
          parts: [
            "sendAudio"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendDocument"
          parts: [
            "sendDocument"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendLocation"
          parts: [
            "sendLocation"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendMessage"
          parts: [
            "sendMessage"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendPhoto"
          parts: [
            "sendPhoto"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendPoll"
          parts: [
            "sendPoll"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendSticker"
          parts: [
            "sendSticker"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/sendVideo"
          parts: [
            "sendVideo"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
